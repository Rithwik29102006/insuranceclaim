# Streamlit Community Cloud Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml for local testing, or paste into
# Streamlit Community Cloud -> App Settings -> Secrets.

# Nebius Token Factory API key
NEBIUS_API_KEY = "your_nebius_api_key_here"

# Nebius Token Factory base URL
NEBIUS_BASE_URL = "https://api.tokenfactory.nebius.com/v1/"

# NVIDIA Nemotron reasoning model ID for policy compilation
NEBIUS_MODEL_REASONING = "<model id from your Token Factory catalog>"

# NVIDIA Nemotron fast model ID for extraction and agent action selection
NEBIUS_MODEL_FAST = "<model id from your Token Factory catalog>"

# Tavily search API key for statutory and regulatory guidance
TAVILY_API_KEY = "your_tavily_api_key_here"

# Optional path to Tesseract OCR executable
TESSERACT_CMD = ""

# Optional path to Tesseract language traineddata directory
TESSDATA_PREFIX = ""
